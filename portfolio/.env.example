# Copie para .env.local e preencha. Nunca commite o .env.local.

# Token do GitHub (opcional). Sem ele a API aceita 60 requisições por hora;
# com ele, 5.000. Crie em https://github.com/settings/tokens um token
# "fine-grained" sem nenhuma permissão extra (só leitura de repositórios públicos).
GITHUB_TOKEN=

# Supabase (banco das mensagens e login do painel). Em Project Settings → API
# Keys: a URL do projeto e a "publishable key" (pública; quem protege os dados
# são as políticas de RLS em supabase/migrations). Na Vercel, a integração do
# Supabase cria estas duas sozinha.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Resend (e-mail avisando de cada mensagem nova). Crie a chave em
# https://resend.com/api-keys. Sem ela, a mensagem é salva mas o e-mail não sai.
RESEND_API_KEY=
# Para quem vai o aviso (padrão: o e-mail de data/profile.ts)
CONTACT_TO_EMAIL=
# Remetente. O padrão onboarding@resend.dev só entrega para o e-mail da conta
# do Resend; para outro remetente, verifique um domínio no Resend.
CONTACT_FROM_EMAIL=
